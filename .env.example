# claudex-dash — environment configuration
#
# Copy to `.env` (git-ignored) and fill in. Bun auto-loads `.env` at startup, so no extra wiring is
# needed. Every value here is OPTIONAL: with no Firebase config present, analytics stays a complete
# no-op and the dashboard behaves exactly as it did before — nothing is sent anywhere.

# ---------------------------------------------------------------------------
# Firebase Analytics (optional)
# ---------------------------------------------------------------------------
# These are the "public" Firebase web-app keys from your Firebase project settings
# (Project settings → General → Your apps → Web app → SDK setup and configuration).
# They are safe to expose to the browser. Analytics only turns on when ALL of
# FIREBASE_API_KEY, FIREBASE_PROJECT_ID, FIREBASE_APP_ID and FIREBASE_MEASUREMENT_ID
# are set; leave any blank to keep analytics off.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Local kill-switch. Set to "off" to disable analytics on THIS machine even when the
# Firebase config above is present. Anything else (unset, "on", "1") leaves it enabled.
# A separate Firebase Remote Config flag (`analytics_enabled`) can disable it remotely
# across all installs.
CLAUDEX_DASH_ANALYTICS=on

# ---------------------------------------------------------------------------
# Existing options (unrelated to analytics)
# ---------------------------------------------------------------------------
# PORT=4400
# CLAUDEX_ME=you@example.com
# CLAUDEX_BIN=/opt/homebrew/bin/claudex
